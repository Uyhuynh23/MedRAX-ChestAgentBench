# ==============================================================================
# Environment Configuration Template for MedRAX
# Rename this file to `.env` or set these in Google Colab Secrets
# ==============================================================================

# LLM Providers (At least one required for Agent backbone)
OPENAI_API_KEY="your-openai-api-key-here"
# Optional custom endpoint (e.g., Azure OpenAI, vLLM, Ollama, DeepSeek, Qwen)
# OPENAI_BASE_URL="https://api.openai.com/v1"
# OPENAI_MODEL="chatgpt-4o-latest"

# Google Gemini API Key (if using Gemini backbones)
GOOGLE_API_KEY=""

# Hugging Face Access Token (required for downloading gated models like Maira-2 / MedGemma)
HF_TOKEN=""

# Persistent Storage Directories (Mapped to Google Drive in Colab)
# In Colab: /content/drive/MyDrive/MedRAX_Thesis/checkpoints
MEDRAX_MODEL_DIR="./checkpoints"
# In Colab: /content/drive/MyDrive/MedRAX_Thesis/data/chestagentbench
BENCHMARK_DATA_DIR="./data/chestagentbench"
# In Colab: /content/drive/MyDrive/MedRAX_Thesis/cache/huggingface
HF_HOME="./cache/huggingface"

# Runtime Settings
DEVICE="cuda"
TEMP_DIR="./temp"
LOG_DIR="./logs"
